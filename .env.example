# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# ── Data ──────────────────────────────────────────────────────────────────
DATA_DIR=./data
# DATABASE_PATH=./data/arkzormd.db
# WEB_DIST=./apps/web/dist

# ── Web UI & approval ─────────────────────────────────────────────────────
# Kosongkan selama pengembangan. Isi minimal 16 karakter acak untuk memakai
# endpoint keputusan approval dari Web UI/API.
ADMIN_TOKEN=
# JID Owner, contoh: 6281234567890@s.whatsapp.net
OWNER_JID=

# ── Bot ───────────────────────────────────────────────────────────────────
PREFIX=.
BOT_NAMES=Arka
# closed | auto-member | approval
ACCESS_MODE=closed
# off | mention | active
DEFAULT_CHAT_MODE=mention

# ── WhatsApp ──────────────────────────────────────────────────────────────
# live | mock | off
# mock = adapter palsu untuk pengembangan, tanpa koneksi WhatsApp.
# live = koneksi nyata lewat onigis. Native E2EE hanya Linux x64/arm64,
#        jadi di Windows/macOS gunakan Docker atau WSL.
WHATSAPP_MODE=mock
# true = langsung pairing/connect saat startup (dipakai untuk live).
WHATSAPP_AUTOCONNECT=false
# Modul adapter; gunakan onigis (fork Baileys 7 + E2EE MIT).
WHATSAPP_MODULE=onigis

# ── AI Provider ───────────────────────────────────────────────────────────
# mock | openai | gemini
# mock = tidak memanggil jaringan (default pengembangan).
# openai = endpoint kompatibel OpenAI: OpenAI, OpenRouter, Ollama, vLLM, dll.
# gemini = Google Gemini generateContent.
AI_PROVIDER=mock
# Kosongkan untuk default: mock, gpt-4o-mini (openai), gemini-2.5-flash (gemini).
AI_MODEL=
# Model cadangan opsional jika model utama gagal (FR-10).
AI_FALLBACK_MODEL=
# Timeout satu request AI dalam milidetik (1000–300000).
AI_TIMEOUT_MS=60000

# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter : https://openrouter.ai/api/v1
# Ollama     : http://127.0.0.1:11434/v1  (API key boleh kosong)

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

