# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# ── Data ──────────────────────────────────────────────────────────────────
DATA_DIR=./data
# DATABASE_PATH=./data/arkzormd.db
# WEB_DIST=./apps/web/dist

# ── Web UI & approval ─────────────────────────────────────────────────────
# Kosongkan selama pengembangan. Isi minimal 16 karakter acak untuk memakai
# endpoint keputusan approval dari Web UI/API.
ADMIN_TOKEN=
# JID Owner, contoh: 6281234567890@s.whatsapp.net
OWNER_JID=

# ── Bot ───────────────────────────────────────────────────────────────────
PREFIX=.
BOT_NAMES=Arka
# closed | auto-member | approval
ACCESS_MODE=closed
# off | mention | active
DEFAULT_CHAT_MODE=mention

# ── WhatsApp ──────────────────────────────────────────────────────────────
# live | mock | off
# mock = adapter palsu untuk pengembangan, tanpa koneksi WhatsApp.
# live = koneksi nyata lewat onigis. Native E2EE hanya Linux x64/arm64,
#        jadi di Windows/macOS gunakan Docker atau WSL.
WHATSAPP_MODE=mock
# true = langsung pairing/connect saat startup (dipakai untuk live).
WHATSAPP_AUTOCONNECT=false
# Modul adapter; gunakan onigis (fork Baileys 7 + E2EE MIT).
WHATSAPP_MODULE=onigis

# ── AI Provider ───────────────────────────────────────────────────────────
# mock | openai | gemini  (openai/gemini menyusul di M1)
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
