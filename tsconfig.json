{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/server/src/**/*.ts",
    "apps/server/tsup.config.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/vite.config.ts",
    "plugins/*/src/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist"]
}
